{{ "style.css" | asset_url | stylesheet_tag }}

<section>
    <div class="product-section">
      <div class="product-featured-task">
            {% if product.images.size > 0 %}
                {% for image in product.images %}
                    <img src="{{ image | image_url: width: 1000 }}" width="" height="" alt="">  
                {% endfor %}
            {% else %}
                {{ "product-1" | placeholder_svg_tag }}
            {% endif %}
        </div>
        <div class="product-content">
            <p>1) Basic Product Information</p>
            <p>Product id:</p> <span>{{ product.id }}</span>
            <p>Product title:</p> <span>{{ product.title }}</span>
            <p>Product handle:</p> <span>{{ product.handle }}</span>
            <p>Product description: </p> <span>{{ product.description }}</span>
            <p>Product description (stripped): </p> <span>{{ product.description | strip_html }}</span>
            <p>Product vendor:</p> <span>{{ product.vendor }}</span>
            <p>Product type: </p> <span>{{ product.type }}</span>    
            <p>Product tags: </p> <span>{{ product.tags | join: ", " }}</span>    
            <p>Product created at:</p> <span>{{ product.created_at }}</span>   
            <p>Product updated at:</p> <span>{{ product.updated_at }}</span>
            <p>Product published at: </p> <span>{{ product.published_at }}</span>
            <p>Product url: </p>  <span>{{ product.url }}</span>
            <p>Product available: </p>  <span>{{ product.available }}</span>
            <p>Product price (max): </p>  <span>{{ product.price_min | money }}</span>
            <p>Product price (min): </p>  <span>{{ product.price_max | money}}</span>
            <p>Product featured_image: </p>  
            <img src="{{ product.featured_image | image_url: width: 1000 }}" width="50" height="50" alt="">
            <p>{{ product.featured_image }}</p>  
            <p>2) Product Options</p>
            {% if product.options.size > 0 %}
              {% for option in product.options_with_values %}
                <p>Option name: </p> <span>{{ option.name }}</span> 
                <p>Option values: </p> <span>{{ option.values | join: ", " }}</span> 
              {% endfor %}
            {% endif %}
            <p>3) Product Images</p>
            {% for image in product.images %}
              <p>Image id: </p> <span>{{ image.id }}</span>
              <p>Image src: </p> <span>{{ image.src }}</span>
              <p>Image alt: </p> <span>{{ image.alt }}</span>
              <img src="{{ image.src | image_url: width: 1000, height: 1000}}" width="" height="" alt="">
            {% endfor %}
            <p>4) Product Variants</p>
            {% for variant in product.variants %}
                <p>Variant id: </p> <span>{{ variant.id }}</span>
                <p>Title: </p> <span>{{ variant.title }}</span> 
                <p>Sku: </p> <span>{{ variant.sku }}</span> 
                <p>Price: </p> <span>{{ variant.price | money }}</span> 
                <p>Compare at price: </p> <span>{{ variant.compare_at_price }}</span>
                <p>Available: </p> <span>{{ variant.available }}</span>
                <p>Inventory quantity: </p> <span>{{ variant.inventory_quantity }}</span>
                <p>Inventory policy: </p> <span>{{ variant.inventory_policy }}</span>
                <p>Barcode: </p> <span>{{ variant.barcode }}</span>
            {% endfor %}
            <p>Selected options: </p>
            {% for option in product.options_with_values %}
                <span>{{ option.name }}: {{ option.values | join: ", " }}</span>
            {% endfor %}
        </div>
    </div>
</section>

<script type="text/javascript">
  console.log("Variants: ", {{ product.variants[0].options[0] | json }})
  console.log("Product: ", {{ product | json }})
  console.log("Product options with values: ", {{ product.options_with_values | json }})
  console.log("Variants", {{ product.variants | json }})
</script>


