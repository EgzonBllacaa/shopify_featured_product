<section>
    <div class="product-section">
        <div class="product-images">
            {% if product.images.size > 0 %}
                {% for image in product.images %}
                    {% if image != blank %}
                        <img src="{{ image | image_url: width: 100, height: 200  }}" class="product-image" width="100" height="200" alt="">
                        {% comment %} <img src="{{ section.settings.image | image_url: width: 100, height: 200 }}" width="100" height="100" alt=""> {% endcomment %}
                    {% endif %}
                {% endfor %}    
            {% else %}
                {{ "product-1" | placeholder_svg_tag }}
            {% endif %}
        </div>
        <div class="product-content">
            <div class="product-content_title">
                {% if section.settings.product_title != blank %}
                    <h2>{{ section.settings.product_title }}</h2>
                    {% else %}
                        {% if product.title != blank %}
                            <h2>{{ product.title }}</h2>
                        {% endif %}
                {% endif %}
                {% if product.vendor != blank %}
                    <span>{{ product.vendor }}</span>
                {% endif %}
                    <div>
                        {% if section.settings.product_price != blank and section.settings.product_compare_at_price != blank %}
                            {% if section.settings.product_compare_at_price != blank and section.settings.compare_at_price > section.settings.product_price %}
                                <div style="display: flex; gap: 10px">
                                    <span>Discount: {{ product.price | money }}</span>
                                    <span class="product-old-price">Original Price: {{ product.compare_at_price | money }}</span>
                                </div>
                                {% else %}
                                    <span>Price: {{ product.compare_at_price | money }}</span>
                            {% endif %}
                            {% else %}
                            {% if product.compare_at_price != blank and product.compare_at_price > product.price %}
                                <div style="display: flex; gap: 10px">
                                    <span>Discount: {{ product.price | money }}</span>
                                    <span class="product-old-price">Original Price: {{ product.compare_at_price | money }}</span>
                                </div>
                                {% else %}
                                <span>Price: {{ product.compare_at_price | money }}</span>
                            {% endif %}
                        {% endif %}
                        <div>
                            {% comment %} {{- product. | inline_asset_content -}} {% endcomment %}
                        </div>
                    </div>
                    <div style="display: flex; flex-direction: column">
                        <span style="text-decoration: underline">What's My Size?</span>
                        <span style="text-decoration: underline">Size Guide</span>
                    </div>
            </div>
            <div class="product-content_variants">
                <div>
                    <span>Fit</span>
                    {% if product.variants.size > 0 %}
                        <div class="product-fit_colors">

                            {% for variant in product.variants %}
                                <div class="product-variants">
                                    {{ variant.option1  }}
                                </div>
                            {% endfor %}
                        </div>
                        {% endif %}
                </div>
                <div>
                    <span>Colors:</span>
                    {% if product.variants.size > 0 %}
                        <div class="product-fit_colors">
                            {% for variant in product.variants %}
                                <div class="product-variants" style="background-color: {{ variant.option2 | downcase }}; padding: 10px 10px; border-radius: 10px"></div>
                            {% endfor %}
                        </div>
                        {% endif %}
                </div>
                <div>
                    <span style="display: block;">Tags</span>
                    {% if product.tags != nil %}
                        {% for tag in product.tags %}
                            <button class="product-variants button_class">{{ tag }}</button>
                        {% endfor %}
                    {% endif %}
                    </div>
                <div>
                    {% if product.available == true %}
                        <div class="product-checkout">
                            <div>
                                <button>Add to bag</button>
                                {% comment %} Heart Icon here {% endcomment %}
                            </div>
                            <div class="product-free_delivery">
                                <div>
                                    <button>Free delivery</button>
                                    <button>Free Returns</button>
                                </div>
                                {% comment %} dropdown icon that i can't figure out how to import :) {% endcomment %}
                            </div>
                        </div>
                    {% else %}
                        <button>Sold out</button>
                    {% endif %}
                </div>
                <div>
                    <p>Product Details</p>
                    <div>
                        {% if section.settings.content != blank %}
                            <p>
                                {{ section.settings.content }}
                            </p>
                            {% else %}
                                {% if product.description != blank %}
                                    <p>
                                        {{ product.description }}
                                    </p>
                                {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% stylesheet %}
 
    * {
        padding: 0;
        margin: 0;
        box-sizing: border-box;
    }
    .product-section {
        width: 100%;
        display: flex;
        gap: 40px;
        justify-content: center;
    }
    .product-variants {
        border: 1px solid gray; 
        padding: 10px 20px;
        border-color: gray;
    }
    .product-variants.button_class {
        background: white;
    }
    .product-old-price {
        text-decoration: line-through;
        color: red;
    }
    .product-images {
        width: 50%;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }
    .product-checkout div:first-child button {
        width: 100%;
        background-color: black;
        color: white;

        font-weight: bold;
        border: none;
    }
    .product-checkout div button {
        padding: 20px 0;
    }
    .product-checkout div:last-child {
        display: flex;
        width: 100%;
    }
    .product-checkout div:last-child button {
        width: 100%;
        padding: 10px 15px;
        border: 1px solid gray;
        
        color: black;
        background: none;
    }
    .product-checkout div:last-child button:first-child {
        border-right: 0px
    }
    .product-content {
        width: 50%;
    }
    .product-content_title h2 {
        font-size: 24px;
        margin-bottom: 8px;
    }
    .product-checkout {
        margin: 30px 0;
    }
    .product-content:first-child {
        margin: 0;
    }
    .product-content_variants {
        margin: 30px 0;
    }
    .product-content_variants >  div {
        margin: 10px 0;
    }
    .product-content_variants div:last-child {
        color: 	#3b3b3b;
    }
    .product-image {
        width: calc(50% - 10px);  
        object-fit: cover;
    }
    .product-fit_colors {
        display: flex;
        gap: 10px; 
        margin: 2px 0px;
        flex-wrap: wrap;
    }
    .product-free_delivery div  {
        margin-top: 4px;
    }
    /* .product-free_delivery div button:last-child  {
        border-left: 0px;
    } */
{% endstylesheet %}

<script type="text/javascript">
  console.log({{ product | json }});
</script>


{% schema %}
    {
        "name": "Featured Product",
        "settings": [
            {
                "type": "text",
                "id": "product_title",
                "label": "title",
            },
            {
                "type": "number",
                "id": "product_price",
                "label": "Product Price",
            },
            {
                "type": "number",
                "id": "product_compare_at_price",
                "label": "Compare at price"
            },
            {
                "type": "image_picker",
                "id": "image",
                "label": "Select new images",
            },
            {
                "type": "richtext",
                "id": "content",
                "label": "Adjust the description",
            },

        ],
        "presets": [
            {
                "name": "Featured Product"
            }
        ]
    }
{% endschema %}